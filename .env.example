# Copy to .env for local overrides. Never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. The default matches docker-compose.
DATABASE_URL=postgresql+psycopg://trustify:trustify@localhost:5432/trustify

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# local writes under backend/var/storage. s3 is rejected until the S3 client is implemented.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/storage
S3_BUCKET=
AWS_REGION=us-east-1

# Leave empty in development to use the local signing key. Never put a real secret in frontend code.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# 100 MiB.
MAX_UPLOAD_BYTES=104857600

# inline = analyze in the API process. celery = require a worker + Redis.
ANALYSIS_MODE=inline

# Optional integrations. Empty means the feature stays unavailable or uses only published test vectors.
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=

# Phase 3 visual detectors (requires backend/requirements-ml.txt)
ENABLE_ML_DETECTORS=true
AI_IMAGE_MODEL_ID=umm-maybe/AI-image-detector
DEEPFAKE_IMAGE_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
VIDEO_DETECTOR_MAX_FRAMES=8
